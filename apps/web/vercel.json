{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": [
    {
      "key": "NEXT_PUBLIC_SITE_URL",
      "value": "https://alisherdev.uz"
    },
    {
      "key": "NEXT_PUBLIC_APP_NAME",
      "value": "AlisherDev"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "public": true
}
