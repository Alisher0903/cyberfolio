# Environment configuration example
# Copy this file to .env.local and fill in the values

# Next.js configuration
NEXT_PUBLIC_SITE_URL=https://alisherdev.uz
NEXT_PUBLIC_APP_NAME=AlisherDev

# Analytics (optional)
# Google Analytics
NEXT_PUBLIC_GA_ID=

# Web Vitals monitoring
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Contact information (public - safe to expose)
NEXT_PUBLIC_EMAIL=info@alisherdev.uz
NEXT_PUBLIC_PHONE=+998 (90) 880-03-13

# Social links
NEXT_PUBLIC_GITHUB_URL=https://github.com/Alisher0903
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/alisher-sodiqov-491183310
NEXT_PUBLIC_TWITTER_URL=https://x.com/ascyber777
NEXT_PUBLIC_WEBSITE_URL=https://alisherdev.uz

# Portfolio API (apps/web and apps/admin)
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# Supabase public configuration (apps/admin)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API-only secrets (never expose these with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
