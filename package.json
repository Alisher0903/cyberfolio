{
  "name": "alisherdev-monorepo",
  "version": "1.0.0",
  "description": "AlisherDev portfolio, admin CMS, and API monorepo",
  "author": {
    "name": "Alisher Sodiqov",
    "email": "info@alisherdev.uz",
    "url": "https://alisherdev.uz"
  },
  "homepage": "https://alisherdev.uz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alisher0903/my-site.git"
  },
  "keywords": [
    "portfolio",
    "frontend",
    "developer",
    "next.js",
    "react",
    "typescript",
    "tailwind"
  ],
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @alisherdev/web --filter @alisherdev/admin --filter @alisherdev/api dev",
    "dev:web": "pnpm --filter @alisherdev/web dev",
    "dev:admin": "pnpm --filter @alisherdev/admin dev",
    "dev:api": "pnpm --filter @alisherdev/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "test": "pnpm --recursive test",
    "format": "prettier --write \"{apps,packages}/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "validate": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "15.5.19",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "autoprefixer": "^10.0.1",
    "commitlint": "^21.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
